# Configuración del despliegue con docker compose. Copia este archivo a `.env`
# en la raíz del repositorio (no se versiona) y completa los valores.
#
# No es el .env de desarrollo: ese está en servidor/api/.env y frontend/.env.

# La base PostgreSQL del servidor, con el esquema de Alejandro ya instalado.
# Si la base corre en el mismo servidor fuera de Docker, usa host.docker.internal
# en vez de localhost. Si la clave tiene @ : / # o %, escríbelos codificados
# (%40 %3A %2F %23 %25).
DATABASE_URL=postgresql://usuario:clave@host.docker.internal:5432/estadistica_hrl

# Secreto con el que se firman los JWT: al menos 32 caracteres, aleatorio y
# distinto del de desarrollo. La API no arranca con uno más corto.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=

# Puerto del servidor donde se publica el sistema.
PUERTO_WEB=80

# Procesos de la API.
# WEB_CONCURRENCY=2

# Vacía (VITE_API_URL=), el frontend se compila en modo demo: todo en memoria,
# sin login real. Cambiarla exige reconstruir: docker compose up -d --build
# VITE_API_URL=http://api:8000

# ---------------------------------------------------------------- Hospitalización
# Egresos Hospitalarios (servidor/hospitalizacion/): se levanta con el resto, con su
# propia base en el contenedor `hospitalizacion-db` (docs/DESPLIEGUE.md § «Hospitalización»).
# No hay nada que configurar: las claves de esa base se generan solas al primer arranque.
#
# Solo para usar el PostgreSQL del servidor en vez del contenedor (con la base `egresos`
# ya creada, ver docs/DESPLIEGUE.md), se escriben aquí el host y las cuatro claves:
# EGRESOS_DB_HOST=host.docker.internal
# EGRESOS_DB_PUERTO=5432
# EGRESOS_DB=egresos
# EGRESOS_OWNER_CLAVE=
# EGRESOS_APP_CLAVE=
# EGRESOS_LECTURA_CLAVE=
# EGRESOS_RESPALDO_CLAVE=
