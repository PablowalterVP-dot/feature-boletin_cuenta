
# Copia este archivo a `.env` para conectar el frontend al servidor
# (cd servidor && npm run dev). Sin .env, todo corre en memoria: modo demo.

# La API (servidor/api). Vite proxea /api hacia ella: datos reales de Nutrición.
VITE_API_URL=http://localhost:8000

# El bot como servicio, en vez del embebido. Déjalo comentado para `npm run humo`:
# la prueba de humo exige el bot embebido.
# VITE_BOT_URL=http://localhost:8787

# La API de hospitalización (servidor/hospitalizacion/). Por omisión, http://localhost:8010.
# VITE_HOSPITALIZACION_URL=http://localhost:8010
