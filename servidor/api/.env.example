# Copia este archivo a `.env` (que no se versiona) y ajusta los valores.

# Base de DESARROLLO. Sirve `postgresql://…`: se traduce al driver psycopg 3.
DATABASE_URL=postgresql://usuario:clave@localhost:5432/estadistica_hrl

# Base SOLO PARA PRUEBAS, distinta de la anterior. `pytest` borra y recrea su
# esquema `public`; se niega a correr si es la misma que DATABASE_URL.
DATABASE_URL_PRUEBAS=postgresql://usuario:clave@localhost:5432/estadistica_hrl_pruebas

# Secreto con el que se firman los JWT: al menos 32 caracteres, aleatorio y
# distinto por entorno. La API no arranca con uno más corto.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=

# Servicio del bot validador (servidor/bot-validador/, `npm start`). Sin él, cargar un
# Excel de un área que el bot conoce falla.
BOT_VALIDADOR_URL=http://localhost:8787

# Dónde se guardan los archivos subidos. Por omisión, servidor/api/cargas/ (no se
# versiona). Puede ser una ruta absoluta si conviene guardarlos en otro disco.
# RUTA_CARGAS=cargas
