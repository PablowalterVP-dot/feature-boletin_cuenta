# Copia este archivo como servidor/hospitalizacion/.env y escribe tus propios valores. .env no se sube al repositorio.
# La base es aparte de la de Estadística (decisión 0011). En desarrollo, el PostgreSQL de
# docker-compose.dev.yml en el 5544; en Docker, el del servidor (host.docker.internal).
EGRESOS_DB_HOST=127.0.0.1
EGRESOS_DB=egresos
EGRESOS_DB_PUERTO=5544
EGRESOS_OWNER_CLAVE=
EGRESOS_APP_CLAVE=
EGRESOS_LECTURA_CLAVE=
EGRESOS_RESPALDO_CLAVE=
# Firma de las sesiones (JWT): al menos 32 caracteres. Con INGRESO=estadistica tiene que
# ser EL MISMO que JWT_SECRETO de servidor/api/.env: el token lo firma la API de
# Estadística y esta lo lee. La API no arranca con uno más corto.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=
# Horas que dura una sesión. 12 por omisión: la guardia de enfermería.
# JWT_HORAS=12
# Clave inicial de las cuentas por área. Con APP_ENV=produccion es provisional: cada
# cuenta la cambia al entrar. Para fijar una clave: python -m semillas.asignar_clave <usuario>
CLAVE_INICIAL_CUENTAS=
# Con INGRESO=propio y produccion, la clave inicial de las cuentas es provisional.
APP_ENV=desarrollo
# propio: el ingreso de este sistema (para probarlo solo). estadistica: el token lo emite el
# Sistema de Reporte Estadístico y las cuentas viven en su base (fase 3 de la decisión 0011).
INGRESO=propio
