  <diagram id="eIKDVgkM0SzMXB5O2q7E" name="Página-15">
    <mxGraphModel dx="1273" dy="768" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="panel_interrelaciones" parent="1" style="swimlane;html=1;startSize=28;fillColor=#0f172a;strokeColor=#334155;fontStyle=1;fontSize=11;fontColor=#ffffff;collapsible=0;rounded=1;shadow=1;" value="DESCRIPCIÓN DE INTERRELACIONES OPERATIVAS, DEPENDENCIAS Y COLISIONES (MODELO AS-IS)" vertex="1">
          <mxGeometry height="710" width="860" x="60" y="60" as="geometry" />
        </mxCell>
        <mxCell id="t_bloque1" parent="panel_interrelaciones" style="text;html=1;fontStyle=1;fontSize=10;fontColor=#ffffff;align=left;verticalAlign=middle;fillColor=#e51400;strokeColor=#B20000;" value="1. COLISIÓN ASISTENCIAL Y ANALÍTICA (Línea Roja #B20000)" vertex="1">
          <mxGeometry height="20" width="500" x="20" y="38" as="geometry" />
        </mxCell>
        <mxCell id="d_cq_go" parent="panel_interrelaciones" style="text;html=1;fontSize=8.5;fontColor=#e2e8f0;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;• &lt;b&gt;Centro Quirúrgico &amp;lt;--&amp;gt; Gineco-Obstetricia:&lt;/b&gt; Conflicto epistemológico en el cómputo de cesáreas. Gineco calcula según recién nacidos vivos (parto gemelar = 2 cesáreas), mientras Centro Quirúrgico computa actos operatorios netos en mesa (1 cesárea). Estadística descarta por regla heurística las cifras de Gineco y valida las de Quirófano.&lt;/span&gt;" vertex="1">
          <mxGeometry height="42" width="820" x="20" y="60" as="geometry" />
        </mxCell>
        <mxCell id="d_est_plan" parent="panel_interrelaciones" style="text;html=1;fontSize=8.5;fontColor=#fca5a5;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;• &lt;b&gt;Estadística --&amp;gt; Planeamiento:&lt;/b&gt; Ruptura del flujo por desfase del Boletín Estadístico Web. CEPLAN bloquea el aplicativo el día 10 sin prórroga; Estadística cierra ante DIRESA Loreto hacia el día 15 y el boletín sufre retrasos de 30 a 45 días, forzando a Planeamiento a activar un circuito de contingencia telefónica y física.&lt;/span&gt;" vertex="1">
          <mxGeometry height="42" width="820" x="20" y="105" as="geometry" />
        </mxCell>
        <mxCell id="sep_d1" parent="panel_interrelaciones" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;strokeColor=#334155;" value="" vertex="1">
          <mxGeometry height="6" width="820" x="20" y="152" as="geometry" />
        </mxCell>
        <mxCell id="t_bloque2" parent="panel_interrelaciones" style="text;html=1;fontStyle=1;fontSize=10;fontColor=#ffffff;align=left;verticalAlign=middle;fillColor=#a0522d;strokeColor=#6D1F00;" value="2. RED SATÉLITE ASISTENCIAL DE FARMACIA (Línea Marrón #6D1F00)" vertex="1">
          <mxGeometry height="20" width="500" x="20" y="162" as="geometry" />
        </mxCell>
        <mxCell id="d_farm_areas" parent="panel_interrelaciones" style="text;html=1;fontSize=8.5;fontColor=#e2e8f0;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;• &lt;b&gt;Farmacia --&amp;gt; Gineco-Obstetricia, Nefrología y Oncología:&lt;/b&gt; Suministro intrahospitalario especializado desde subáreas satélites. Provee kits de cesárea/parto a Gineco, dializadores y soluciones a Nefrología (Farmacia Hemodiálisis), y mezclas citostáticas para esquemas de quimioterapia a Oncología. El desabastecimiento impacta en cancelaciones de turnos asistenciales.&lt;/span&gt;" vertex="1">
          <mxGeometry height="42" width="820" x="20" y="184" as="geometry" />
        </mxCell>
        <mxCell id="sep_d2" parent="panel_interrelaciones" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;strokeColor=#334155;" value="" vertex="1">
          <mxGeometry height="6" width="820" x="20" y="230" as="geometry" />
        </mxCell>
        <mxCell id="t_bloque3" parent="panel_interrelaciones" style="text;html=1;fontStyle=1;fontSize=10;fontColor=#000000;align=left;verticalAlign=middle;fillColor=#e3c800;strokeColor=#B09500;" value="3. DEPENDENCIAS DE INFRAESTRUCTURA Y SERVICIOS GENERALES (Líneas Ámbar y Fucsia)" vertex="1">
          <mxGeometry height="20" width="600" x="20" y="240" as="geometry" />
        </mxCell>
        <mxCell id="d_lav_mant" parent="panel_interrelaciones" style="text;html=1;fontSize=8.5;fontColor=#e2e8f0;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;• &lt;b&gt;Lavandería y Costurería --&amp;gt; Mantenimiento (Ámbar #BD7000):&lt;/b&gt; Cuello de botella informático. Al carecer de equipo de cómputo propio y secretaria, el personal de Lavandería traslada sus cuadernos físicos para que en la oficina de Mantenimiento se digiten los pesajes acumulados en Excel antes del día 8.&lt;/span&gt;" vertex="1">
          <mxGeometry height="38" width="820" x="20" y="262" as="geometry" />
        </mxCell>
        <mxCell id="d_cost_cq" parent="panel_interrelaciones" style="text;html=1;fontSize=8.5;fontColor=#e2e8f0;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;• &lt;b&gt;Costurería --&amp;gt; Centro Quirúrgico (Fucsia #A50040):&lt;/b&gt; Dependencia de esterilización y lencería médica. Confección, acondicionamiento y provisión de paquetes quirúrgicos (campos fenestrados, batas, envolturas y sábanas) indispensables para el sostenimiento de las cirugías de emergencia y programadas.&lt;/span&gt;" vertex="1">
          <mxGeometry height="38" width="820" x="20" y="303" as="geometry" />
        </mxCell>
        <mxCell id="sep_d3" parent="panel_interrelaciones" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;strokeColor=#334155;" value="" vertex="1">
          <mxGeometry height="6" width="820" x="20" y="345" as="geometry" />
        </mxCell>
        <mxCell id="t_bloque4" parent="panel_interrelaciones" style="text;html=1;fontStyle=1;fontSize=10;fontColor=#ffffff;align=left;verticalAlign=middle;fillColor=#647687;strokeColor=#314354;" value="4. SOPORTE DE DIAGNÓSTICO Y VIGILANCIA EPIDEMIOLÓGICA (Gris Pizarra y Neutro)" vertex="1">
          <mxGeometry height="20" width="600" x="20" y="355" as="geometry" />
        </mxCell>
        <mxCell id="d_dxi_cq" parent="panel_interrelaciones" style="text;html=1;fontSize=8.5;fontColor=#e2e8f0;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;• &lt;b&gt;DxI --&amp;gt; Centro Quirúrgico (Gris Pizarra #64748B):&lt;/b&gt; Soporte diagnóstico preoperatorio. Emisión de placas radiográficas y ecografías indispensables para la valoración del riesgo quirúrgico antes del acto operatorio.&lt;/span&gt;" vertex="1">
          <mxGeometry height="28" width="820" x="20" y="377" as="geometry" />
        </mxCell>
        <mxCell id="d_epi_vig" parent="panel_interrelaciones" style="text;html=1;fontSize=8.5;fontColor=#e2e8f0;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;• &lt;b&gt;Gineco / Quirófano --&amp;gt; Epidemiología (Gris Pizarra #314354):&lt;/b&gt; Vigilancia activa de IAAS. Notificación obligatoria de Infecciones de Sitio Quirúrgico (ISQ) desde Quirófano, y fichas de aislamiento (camas 31 a 36) junto a auditoría obligatoria de Muerte Materna y Neonatal desde Gineco-Obstetricia.&lt;/span&gt;" vertex="1">
          <mxGeometry height="38" width="820" x="20" y="408" as="geometry" />
        </mxCell>
        <mxCell id="d_pat_muestras" parent="panel_interrelaciones" style="text;html=1;fontSize=8.5;fontColor=#e2e8f0;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;• &lt;b&gt;Gineco / Quirófano --&amp;gt; Patología Clínica y Anatomía P. (Gris Estándar #000000):&lt;/b&gt; Traspaso de piezas anatómicas de cirugías (úteros, apéndices, vesículas) y láminas citológicas fijadas (PAP) con órdenes físicas para estudio histopatológico.&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="820" x="20" y="449" as="geometry" />
        </mxCell>
        <mxCell id="sep_d4" parent="panel_interrelaciones" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;strokeColor=#334155;" value="" vertex="1">
          <mxGeometry height="6" width="820" x="20" y="483" as="geometry" />
        </mxCell>
        <mxCell id="t_bloque5" parent="panel_interrelaciones" style="text;html=1;fontStyle=1;fontSize=10;fontColor=#ffffff;align=left;verticalAlign=middle;fillColor=#1ba1e2;strokeColor=#006EAF;" value="5. CIRCUITOS DE CIERRE MENSUAL (Azul Institucional vs. Verde CEPLAN)" vertex="1">
          <mxGeometry height="20" width="600" x="20" y="493" as="geometry" />
        </mxCell>
        <mxCell id="d_cierre_est" parent="panel_interrelaciones" style="text;html=1;fontSize=8.5;fontColor=#bae6fd;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;• &lt;b&gt;Canal Azul (#006EAF) --&amp;gt; Estadística:&lt;/b&gt; Entrega de expedientes físicos con sello de cargo (partes, sábanas y libros) hasta el día 5. Abarca a Farmacia, Nutrición (día 2), Quirófano, DxI, Patología, Gineco y Nefrología (cuyo Oficio 135 se archiva pasivamente por falta de resolución en el ROF).&lt;/span&gt;" vertex="1">
          <mxGeometry height="38" width="820" x="20" y="515" as="geometry" />
        </mxCell>
        <mxCell id="d_cierre_plan" parent="panel_interrelaciones" style="text;html=1;fontSize=8.5;fontColor=#bbf7d0;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;• &lt;b&gt;Canal Verde (#2D7600) --&amp;gt; Planeamiento:&lt;/b&gt; Remisión de metas físicas del POI/CEPLAN antes del día 10. Incluye oficios de Farmacia, cirugías de Quirófano, informe en Word de Gineco (para bonos), CUI de Mantenimiento, producción de DxI y Patología, y metas PPR de Cáncer de Oncología.&lt;/span&gt;" vertex="1">
          <mxGeometry height="38" width="820" x="20" y="556" as="geometry" />
        </mxCell>
        <mxCell id="sep_d5" parent="panel_interrelaciones" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;strokeColor=#334155;" value="" vertex="1">
          <mxGeometry height="6" width="820" x="20" y="598" as="geometry" />
        </mxCell>
        <mxCell id="d_fuentes" parent="panel_interrelaciones" style="text;html=1;fontSize=8;fontColor=#94a3b8;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=2;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;Evidencia probatoria:&lt;/b&gt; Oficio 029 (Mantenimiento / 13,616 kg de lavandería)[cite: 8], Oficio 456 (Farmacia)[cite: 8], Oficio 135 (Nefrología / 934 sesiones)[cite: 8, 9], Oficio 045 (DxI)[cite: 8], Oficio 097 (Centro Quirúrgico)[cite: 8] y entrevistas a Sra. Souza (Estadística)[cite: 8, 14], CEPLAN[cite: 8, 12], Lic. Luisa Acosta (Ginecología)[cite: 8, 12] y Sra. Orfa Collantes (Lavandería)[cite: 8, 12].&lt;/span&gt;" vertex="1">
          <mxGeometry height="35" width="820" x="20" y="610" as="geometry" />
        </mxCell>
        <mxCell id="d_metodologia" parent="panel_interrelaciones" style="text;html=1;fontSize=8;fontColor=#64748b;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=2;" value="&lt;b&gt;Nota de modelado BPMN 2.0:&lt;/b&gt; Todas las líneas discontinuas representan flujos de mensajes (Message Flows) que evidencian trámites físicos en papel, traslado a pie o comunicaciones informales no integradas." vertex="1">
          <mxGeometry height="25" width="820" x="20" y="650" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
