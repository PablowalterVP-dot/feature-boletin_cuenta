        <mxCell id="DipavXUOpPwvOaVvWAUU-20" parent="DipavXUOpPwvOaVvWAUU-1" style="text;html=1;fontSize=9;fontColor=#ffffff;align=left;verticalAlign=middle;fillColor=#e51400;strokeColor=#B20000;" value="&lt;b&gt;Rojo Bidireccional (#B20000):&lt;/b&gt; Colisión analítica de cesáreas (Gineco: productos nacidos vs. Quirófano: acto quirúrgico)." vertex="1">
          <mxGeometry height="20" width="650" x="90" y="190" as="geometry" />
        </mxCell>
        <mxCell id="DipavXUOpPwvOaVvWAUU-21" parent="DipavXUOpPwvOaVvWAUU-1" style="ellipse;fillColor=none;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="5" width="5" x="25" y="238" as="geometry" />
        </mxCell>
        <mxCell id="DipavXUOpPwvOaVvWAUU-22" parent="DipavXUOpPwvOaVvWAUU-1" style="ellipse;fillColor=none;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="5" width="5" x="75" y="238" as="geometry" />
        </mxCell>
        <mxCell id="DipavXUOpPwvOaVvWAUU-23" edge="1" parent="DipavXUOpPwvOaVvWAUU-1" source="DipavXUOpPwvOaVvWAUU-21" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6D1F00;strokeWidth=3;dashed=1;endArrow=classic;" target="DipavXUOpPwvOaVvWAUU-22" />
        <mxCell id="DipavXUOpPwvOaVvWAUU-24" parent="DipavXUOpPwvOaVvWAUU-1" style="text;html=1;fontSize=9;fontColor=#ffffff;align=left;verticalAlign=middle;fillColor=#a0522d;strokeColor=#6D1F00;" value="&lt;b&gt;Marrón (#6D1F00):&lt;/b&gt; Red satélite de Farmacia (Suministro de kits de cesárea a Gineco, quimio a Onco y filtros a Nefrología)." vertex="1">
          <mxGeometry height="20" width="650" x="90" y="230" as="geometry" />
        </mxCell>
        <mxCell id="DipavXUOpPwvOaVvWAUU-25" parent="DipavXUOpPwvOaVvWAUU-1" style="ellipse;fillColor=none;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="5" width="5" x="25" y="278" as="geometry" />
        </mxCell>
        <mxCell id="DipavXUOpPwvOaVvWAUU-26" parent="DipavXUOpPwvOaVvWAUU-1" style="ellipse;fillColor=none;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="5" width="5" x="75" y="278" as="geometry" />
        </mxCell>
        <mxCell id="DipavXUOpPwvOaVvWAUU-27" edge="1" parent="DipavXUOpPwvOaVvWAUU-1" source="DipavXUOpPwvOaVvWAUU-25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#A50040;strokeWidth=3;dashed=1;endArrow=classic;" target="DipavXUOpPwvOaVvWAUU-26" />
        <mxCell id="DipavXUOpPwvOaVvWAUU-28" parent="DipavXUOpPwvOaVvWAUU-1" style="text;html=1;fontSize=9;fontColor=#ffffff;align=left;verticalAlign=middle;fillColor=#76608a;strokeColor=#432D57;" value="&lt;b&gt;Fucsia (#A50040):&lt;/b&gt; Suministro de lencería esterilizada y paquetes de ropa quirúrgica (Costurería -------&amp;gt; Quirófano)." vertex="1">
          <mxGeometry height="20" width="650" x="90" y="270" as="geometry" />
        </mxCell>
        <mxCell id="DipavXUOpPwvOaVvWAUU-29" parent="DipavXUOpPwvOaVvWAUU-1" style="ellipse;fillColor=none;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="5" width="5" x="25" y="318" as="geometry" />
        </mxCell>
        <mxCell id="DipavXUOpPwvOaVvWAUU-30" parent="DipavXUOpPwvOaVvWAUU-1" style="ellipse;fillColor=none;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="5" width="5" x="75" y="318" as="geometry" />
        </mxCell>
        <mxCell id="DipavXUOpPwvOaVvWAUU-31" edge="1" parent="DipavXUOpPwvOaVvWAUU-1" source="DipavXUOpPwvOaVvWAUU-29" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#BD7000;strokeWidth=3;dashed=1;endArrow=classic;" target="DipavXUOpPwvOaVvWAUU-30" />
        <mxCell id="DipavXUOpPwvOaVvWAUU-32" parent="DipavXUOpPwvOaVvWAUU-1" style="text;html=1;fontSize=9;fontColor=#000000;align=left;verticalAlign=middle;fillColor=#f0a30a;strokeColor=#BD7000;" value="&lt;b&gt;Ámbar (#BD7000):&lt;/b&gt; Cuello de botella informático: traslado físico para digitación de pesajes en PC ajena (Lavandería -------&amp;gt; Mant.)." vertex="1">
          <mxGeometry height="20" width="650" x="90" y="310" as="geometry" />
        </mxCell>
        <mxCell id="DipavXUOpPwvOaVvWAUU-33" parent="DipavXUOpPwvOaVvWAUU-1" style="ellipse;fillColor=none;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="5" width="5" x="25" y="358" as="geometry" />
        </mxCell>
        <mxCell id="DipavXUOpPwvOaVvWAUU-34" parent="DipavXUOpPwvOaVvWAUU-1" style="ellipse;fillColor=none;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="5" width="5" x="75" y="358" as="geometry" />
        </mxCell>
        <mxCell id="DipavXUOpPwvOaVvWAUU-35" edge="1" parent="DipavXUOpPwvOaVvWAUU-1" source="DipavXUOpPwvOaVvWAUU-33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#314354;strokeWidth=3;dashed=1;endArrow=classic;" target="DipavXUOpPwvOaVvWAUU-34" />
        <mxCell id="DipavXUOpPwvOaVvWAUU-36" parent="DipavXUOpPwvOaVvWAUU-1" style="text;html=1;fontSize=9;fontColor=#ffffff;align=left;verticalAlign=middle;fillColor=#647687;strokeColor=#314354;" value="&lt;b&gt;Gris Pizarra (#314354 / #64748B):&lt;/b&gt; Vigilancia IAAS/centinela (Gineco/Quirófano -------&amp;gt; Epidem.) y placas preoperatorias (DxI -------&amp;gt; Quirófano)." vertex="1">
          <mxGeometry height="20" width="650" x="90" y="350" as="geometry" />
        </mxCell>
        <mxCell id="DipavXUOpPwvOaVvWAUU-37" parent="DipavXUOpPwvOaVvWAUU-1" style="ellipse;fillColor=none;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="5" width="5" x="25" y="398" as="geometry" />
        </mxCell>
        <mxCell id="DipavXUOpPwvOaVvWAUU-38" parent="DipavXUOpPwvOaVvWAUU-1" style="ellipse;fillColor=none;strokeColor=none;" value="" vertex="1">
          <mxGeometry height="5" width="5" x="75" y="398" as="geometry" />
        </mxCell>
        <mxCell id="DipavXUOpPwvOaVvWAUU-39" edge="1" parent="DipavXUOpPwvOaVvWAUU-1" source="DipavXUOpPwvOaVvWAUU-37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#000000;strokeWidth=3;dashed=1;endArrow=classic;" target="DipavXUOpPwvOaVvWAUU-38" />
        <mxCell id="DipavXUOpPwvOaVvWAUU-40" parent="DipavXUOpPwvOaVvWAUU-1" style="text;html=1;fontSize=9;fontColor=#ffffff;align=left;verticalAlign=middle;fillColor=#000000;strokeColor=#314354;" value="&lt;b&gt;Negro obscuro (&lt;span style=&quot;color: rgb(255, 255, 255);&quot;&gt;#000000&lt;/span&gt;):&lt;/b&gt; Envío de muestras/biopsias y láminas de Papanicolaou (Quirófano/Gineco --------&amp;gt; Anatomía Patológica)." vertex="1">
          <mxGeometry height="20" width="650" x="90" y="390" as="geometry" />
        </mxCell>
        <mxCell id="DipavXUOpPwvOaVvWAUU-41" parent="DipavXUOpPwvOaVvWAUU-1" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;spacingTop=-1;spacingLeft=3;spacingRight=3;rotatable=0;labelPosition=right;points=[];portConstraint=eastwest;strokeColor=#334155;" value="" vertex="1">
          <mxGeometry height="8" width="720" x="20" y="420" as="geometry" />
        </mxCell>
        <mxCell id="DipavXUOpPwvOaVvWAUU-42" parent="DipavXUOpPwvOaVvWAUU-1" style="text;html=1;fontSize=8;fontColor=#94a3b8;align=left;verticalAlign=middle;fontStyle=2;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;* Todos los flujos discontinuos representan Message Flows (trámite físico, oficios con cargo, muestras biológicas o alertas informales).&lt;/span&gt;" vertex="1">
          <mxGeometry height="20" width="720" x="20" y="435" as="geometry" />
        </mxCell>
        <mxCell id="DipavXUOpPwvOaVvWAUU-43" parent="DipavXUOpPwvOaVvWAUU-1" style="text;html=1;fontSize=8;fontColor=#94a3b8;align=left;verticalAlign=middle;fontStyle=2;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;Fuentes probatorias: Oficios 029 (Mant.), 456 (Farm.), 135 (Nefro.), 045 (DxI), 097 (CQ) y entrevistas de campo (Estadística y CEPLAN).&lt;/span&gt;" vertex="1">
          <mxGeometry height="20" width="720" x="20" y="455" as="geometry" />
        </mxCell>
        <mxCell id="NrS5D1Zlaminxips3QhT-1" parent="1" style="swimlane;html=1;startSize=28;fillColor=#0f172a;strokeColor=#334155;fontStyle=1;fontSize=11;fontColor=#ffffff;collapsible=0;rounded=1;shadow=1;" value="DESCRIPCIÓN DE INTERRELACIONES OPERATIVAS, DEPENDENCIAS Y COLISIONES (MODELO AS-IS)" vertex="1">
          <mxGeometry height="710" width="860" x="-2130" y="-430" as="geometry" />
        </mxCell>
        <mxCell id="NrS5D1Zlaminxips3QhT-2" parent="NrS5D1Zlaminxips3QhT-1" style="text;html=1;fontStyle=1;fontSize=10;fontColor=#ffffff;align=left;verticalAlign=middle;fillColor=#e51400;strokeColor=#B20000;" value="1. COLISIÓN ASISTENCIAL Y ANALÍTICA (Línea Roja #B20000)" vertex="1">
          <mxGeometry height="20" width="500" x="20" y="38" as="geometry" />
        </mxCell>
        <mxCell id="NrS5D1Zlaminxips3QhT-3" parent="NrS5D1Zlaminxips3QhT-1" style="text;html=1;fontSize=8.5;fontColor=#e2e8f0;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;• &lt;b&gt;Centro Quirúrgico &amp;lt;--&amp;gt; Gineco-Obstetricia:&lt;/b&gt; Conflicto epistemológico en el cómputo de cesáreas. Gineco calcula según recién nacidos vivos (parto gemelar = 2 cesáreas), mientras Centro Quirúrgico computa actos operatorios netos en mesa (1 cesárea). Estadística descarta por regla heurística las cifras de Gineco y valida las de Quirófano.&lt;/span&gt;" vertex="1">
          <mxGeometry height="42" width="820" x="20" y="60" as="geometry" />
        </mxCell>
        <mxCell id="NrS5D1Zlaminxips3QhT-4" parent="NrS5D1Zlaminxips3QhT-1" style="text;html=1;fontSize=8.5;fontColor=#fca5a5;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;• &lt;b&gt;Estadística --&amp;gt; Planeamiento:&lt;/b&gt; Ruptura del flujo por desfase del Boletín Estadístico Web. CEPLAN bloquea el aplicativo el día 10 sin prórroga; Estadística cierra ante DIRESA Loreto hacia el día 15 y el boletín sufre retrasos de 30 a 45 días, forzando a Planeamiento a activar un circuito de contingencia telefónica y física.&lt;/span&gt;" vertex="1">
          <mxGeometry height="42" width="820" x="20" y="105" as="geometry" />
        </mxCell>
        <mxCell id="NrS5D1Zlaminxips3QhT-5" parent="NrS5D1Zlaminxips3QhT-1" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;strokeColor=#334155;" value="" vertex="1">
          <mxGeometry height="6" width="820" x="20" y="152" as="geometry" />
        </mxCell>
        <mxCell id="NrS5D1Zlaminxips3QhT-6" parent="NrS5D1Zlaminxips3QhT-1" style="text;html=1;fontStyle=1;fontSize=10;fontColor=#ffffff;align=left;verticalAlign=middle;fillColor=#a0522d;strokeColor=#6D1F00;" value="2. RED SATÉLITE ASISTENCIAL DE FARMACIA (Línea Marrón #6D1F00)" vertex="1">
          <mxGeometry height="20" width="500" x="20" y="162" as="geometry" />
        </mxCell>
        <mxCell id="NrS5D1Zlaminxips3QhT-7" parent="NrS5D1Zlaminxips3QhT-1" style="text;html=1;fontSize=8.5;fontColor=#e2e8f0;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;• &lt;b&gt;Farmacia --&amp;gt; Gineco-Obstetricia, Nefrología y Oncología:&lt;/b&gt; Suministro intrahospitalario especializado desde subáreas satélites. Provee kits de cesárea/parto a Gineco, dializadores y soluciones a Nefrología (Farmacia Hemodiálisis), y mezclas citostáticas para esquemas de quimioterapia a Oncología. El desabastecimiento impacta en cancelaciones de turnos asistenciales.&lt;/span&gt;" vertex="1">
          <mxGeometry height="42" width="820" x="20" y="184" as="geometry" />
        </mxCell>
        <mxCell id="NrS5D1Zlaminxips3QhT-8" parent="NrS5D1Zlaminxips3QhT-1" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;strokeColor=#334155;" value="" vertex="1">
          <mxGeometry height="6" width="820" x="20" y="230" as="geometry" />
        </mxCell>
        <mxCell id="NrS5D1Zlaminxips3QhT-9" parent="NrS5D1Zlaminxips3QhT-1" style="text;html=1;fontStyle=1;fontSize=10;fontColor=#000000;align=left;verticalAlign=middle;fillColor=#e3c800;strokeColor=#B09500;" value="3. DEPENDENCIAS DE INFRAESTRUCTURA Y SERVICIOS GENERALES (Líneas Ámbar y Fucsia)" vertex="1">
          <mxGeometry height="20" width="600" x="20" y="240" as="geometry" />
        </mxCell>
        <mxCell id="NrS5D1Zlaminxips3QhT-10" parent="NrS5D1Zlaminxips3QhT-1" style="text;html=1;fontSize=8.5;fontColor=#e2e8f0;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;• &lt;b&gt;Lavandería y Costurería --&amp;gt; Mantenimiento (Ámbar #BD7000):&lt;/b&gt; Cuello de botella informático. Al carecer de equipo de cómputo propio y secretaria, el personal de Lavandería traslada sus cuadernos físicos para que en la oficina de Mantenimiento se digiten los pesajes acumulados en Excel antes del día 8.&lt;/span&gt;" vertex="1">
          <mxGeometry height="38" width="820" x="20" y="262" as="geometry" />
        </mxCell>
        <mxCell id="NrS5D1Zlaminxips3QhT-11" parent="NrS5D1Zlaminxips3QhT-1" style="text;html=1;fontSize=8.5;fontColor=#e2e8f0;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;• &lt;b&gt;Costurería --&amp;gt; Centro Quirúrgico (Fucsia #A50040):&lt;/b&gt; Dependencia de esterilización y lencería médica. Confección, acondicionamiento y provisión de paquetes quirúrgicos (campos fenestrados, batas, envolturas y sábanas) indispensables para el sostenimiento de las cirugías de emergencia y programadas.&lt;/span&gt;" vertex="1">
          <mxGeometry height="38" width="820" x="20" y="303" as="geometry" />
        </mxCell>
        <mxCell id="NrS5D1Zlaminxips3QhT-12" parent="NrS5D1Zlaminxips3QhT-1" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;strokeColor=#334155;" value="" vertex="1">
          <mxGeometry height="6" width="820" x="20" y="345" as="geometry" />
        </mxCell>
        <mxCell id="NrS5D1Zlaminxips3QhT-13" parent="NrS5D1Zlaminxips3QhT-1" style="text;html=1;fontStyle=1;fontSize=10;fontColor=#ffffff;align=left;verticalAlign=middle;fillColor=#647687;strokeColor=#314354;" value="4. SOPORTE DE DIAGNÓSTICO Y VIGILANCIA EPIDEMIOLÓGICA (Gris Pizarra y Neutro)" vertex="1">
          <mxGeometry height="20" width="600" x="20" y="355" as="geometry" />
        </mxCell>
        <mxCell id="NrS5D1Zlaminxips3QhT-14" parent="NrS5D1Zlaminxips3QhT-1" style="text;html=1;fontSize=8.5;fontColor=#e2e8f0;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;• &lt;b&gt;DxI --&amp;gt; Centro Quirúrgico (Gris Pizarra #64748B):&lt;/b&gt; Soporte diagnóstico preoperatorio. Emisión de placas radiográficas y ecografías indispensables para la valoración del riesgo quirúrgico antes del acto operatorio.&lt;/span&gt;" vertex="1">
          <mxGeometry height="28" width="820" x="20" y="377" as="geometry" />
        </mxCell>
        <mxCell id="NrS5D1Zlaminxips3QhT-15" parent="NrS5D1Zlaminxips3QhT-1" style="text;html=1;fontSize=8.5;fontColor=#e2e8f0;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;• &lt;b&gt;Gineco / Quirófano --&amp;gt; Epidemiología (Gris Pizarra #314354):&lt;/b&gt; Vigilancia activa de IAAS. Notificación obligatoria de Infecciones de Sitio Quirúrgico (ISQ) desde Quirófano, y fichas de aislamiento (camas 31 a 36) junto a auditoría obligatoria de Muerte Materna y Neonatal desde Gineco-Obstetricia.&lt;/span&gt;" vertex="1">
          <mxGeometry height="38" width="820" x="20" y="408" as="geometry" />
        </mxCell>
        <mxCell id="NrS5D1Zlaminxips3QhT-16" parent="NrS5D1Zlaminxips3QhT-1" style="text;html=1;fontSize=8.5;fontColor=#e2e8f0;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;• &lt;b&gt;Gineco / Quirófano --&amp;gt; Patología Clínica y Anatomía P. (Negro obscuro #000000):&lt;/b&gt; Traspaso de piezas anatómicas de cirugías (úteros, apéndices, vesículas) y láminas citológicas fijadas (PAP) con órdenes físicas para estudio histopatológico.&lt;/span&gt;" vertex="1">
          <mxGeometry height="30" width="820" x="20" y="449" as="geometry" />
        </mxCell>
        <mxCell id="NrS5D1Zlaminxips3QhT-17" parent="NrS5D1Zlaminxips3QhT-1" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;strokeColor=#334155;" value="" vertex="1">
          <mxGeometry height="6" width="820" x="20" y="483" as="geometry" />
        </mxCell>
        <mxCell id="NrS5D1Zlaminxips3QhT-18" parent="NrS5D1Zlaminxips3QhT-1" style="text;html=1;fontStyle=1;fontSize=10;fontColor=#ffffff;align=left;verticalAlign=middle;fillColor=#1ba1e2;strokeColor=#006EAF;" value="5. CIRCUITOS DE CIERRE MENSUAL (Azul Institucional vs. Verde CEPLAN)" vertex="1">
          <mxGeometry height="20" width="600" x="20" y="493" as="geometry" />
        </mxCell>
        <mxCell id="NrS5D1Zlaminxips3QhT-19" parent="NrS5D1Zlaminxips3QhT-1" style="text;html=1;fontSize=8.5;fontColor=#bae6fd;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;• &lt;b&gt;Canal Azul (#006EAF) --&amp;gt; Estadística:&lt;/b&gt; Entrega de expedientes físicos con sello de cargo (partes, sábanas y libros) hasta el día 5. Abarca a Farmacia, Nutrición (día 2), Quirófano, DxI, Patología, Gineco y Nefrología (cuyo Oficio 135 se archiva pasivamente por falta de resolución en el ROF).&lt;/span&gt;" vertex="1">
          <mxGeometry height="38" width="820" x="20" y="515" as="geometry" />
        </mxCell>
        <mxCell id="NrS5D1Zlaminxips3QhT-20" parent="NrS5D1Zlaminxips3QhT-1" style="text;html=1;fontSize=8.5;fontColor=#bbf7d0;align=left;verticalAlign=top;whiteSpace=wrap;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;• &lt;b&gt;Canal Verde (#2D7600) --&amp;gt; Planeamiento:&lt;/b&gt; Remisión de metas físicas del POI/CEPLAN antes del día 10. Incluye oficios de Farmacia, cirugías de Quirófano, informe en Word de Gineco (para bonos), CUI de Mantenimiento, producción de DxI y Patología, y metas PPR de Cáncer de Oncología.&lt;/span&gt;" vertex="1">
          <mxGeometry height="38" width="820" x="20" y="556" as="geometry" />
        </mxCell>
        <mxCell id="NrS5D1Zlaminxips3QhT-21" parent="NrS5D1Zlaminxips3QhT-1" style="line;strokeWidth=1;fillColor=none;align=left;verticalAlign=middle;strokeColor=#334155;" value="" vertex="1">
          <mxGeometry height="6" width="820" x="20" y="598" as="geometry" />
        </mxCell>
        <mxCell id="NrS5D1Zlaminxips3QhT-22" parent="NrS5D1Zlaminxips3QhT-1" style="text;html=1;fontSize=8;fontColor=#94a3b8;align=left;verticalAlign=top;whiteSpace=wrap;fontStyle=2;" value="&lt;span style=&quot;color: rgb(0, 0, 0);&quot;&gt;&lt;b&gt;Evidencia probatoria:&lt;/b&gt; Oficio 029 (Mantenimiento / 13,616 kg de lavandería)[cite: 8], Oficio 456 (Farmacia)[cite: 8], Oficio 135 (Nefrología / 934 sesiones)[cite: 8, 9], Oficio 045 (DxI)[cite: 8], Oficio 097 (Centro Quirúrgico)[cite: 8] y entrevistas a Sra. Souza (Estadística)[cite: 8, 14], CEPLAN[cite: 8, 12], Lic. Luisa Acosta (Ginecología)[cite: 8, 12] y Sra. Orfa Collantes (Lavandería)[cite: 8, 12].&lt;/span&gt;" vertex="1">
